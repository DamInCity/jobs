# Environment Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
# Host-side tools: use published port (5433 when Docker maps 5433:5432)
# App container overrides DB_HOST=postgres and DB_PORT=5432 via compose
DB_HOST=localhost
DB_PORT=5433
DB_NAME=jobs_website
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Admin Configuration (for initial setup)
ADMIN_EMAIL=admin@jobswebsite.com
ADMIN_PASSWORD=changethispassword

# Application Settings
APP_NAME=JobsHub
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Email Configuration (for job alerts)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@jobswebsite.com

# Telegram bot (personalized category alerts)
# 1. Message @BotFather → /newbot → copy token + username
# 2. Set both vars below
# 3. docker compose up -d --build   # starts app + telegram-bot
# 4. User opens /alerts → Link Telegram → receives digests matching filters
# Digests: after scrape (if scrapers profile) or: npm run alerts:force
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Alert matching lookback (days) for first send / backfill (default 30)
ALERT_LOOKBACK_DAYS=30
# Diagnostic test loop: while > 0, `npm run alerts:test` sends 1 matched job
# to every Telegram-linked user every N minutes. 0 = off.
ALERT_TEST_INTERVAL_MINUTES=0

# Optional: forward match payloads to n8n for WhatsApp / extra routing
N8N_WEBHOOK_URL=

# Inbound ingest API for n8n → JobsHub (POST /api/ingest/jobs)
# Header: X-Ingest-Key: <value>
# Also pass through docker-compose app service
INGEST_API_KEY=

# SiliconFlow (primary LLM for CV skill profiling + resume tailor / PDF)
# https://cloud.siliconflow.cn → API keys
# Docs: https://docs.siliconflow.cn (OpenAI-compatible chat/completions)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct
# How many tailored PDFs to keep per user (oldest pruned)
# TAILORED_RESUME_KEEP=20

# Optional fallback: xAI / SpaceXAI if SiliconFlow is not set
# https://console.x.ai → XAI_API_KEY
XAI_API_KEY=
# XAI_MODEL=grok-4.5

# Enable Puppeteer HTML scrapers (BrighterMonday). MyJobMag is on by default.
ENABLE_HTML_SCRAPERS=false

# CV uploads (default: ./uploads/cvs)
# CV_UPLOAD_DIR=
# MAX_CV_BYTES=5242880

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# RapidAPI job ingestion
RAPIDAPI_KEY=
RAPIDAPI_MAX_REQUESTS_PER_RUN=80
INGEST_MAX_JOBS_PER_SOURCE=400
