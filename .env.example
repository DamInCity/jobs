# Environment Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
# Host-side tools: use published port (5433 when Docker maps 5433:5432)
# App container overrides DB_HOST=postgres and DB_PORT=5432 via compose
DB_HOST=localhost
DB_PORT=5433
DB_NAME=jobs_website
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Admin Configuration (for initial setup)
ADMIN_EMAIL=admin@jobswebsite.com
ADMIN_PASSWORD=changethispassword

# Application Settings
APP_NAME=JobsHub
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Email Configuration (for job alerts)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@jobswebsite.com

# Telegram bot (personalized category alerts)
# 1. Message @BotFather → /newbot → copy token + username
# 2. Set both vars below
# 3. docker compose up -d --build   # starts app + telegram-bot
# 4. User opens /alerts → Link Telegram → receives digests matching filters
# Digests: after scrape (if scrapers profile) or: npm run alerts:force
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Optional: forward match payloads to n8n for WhatsApp / extra routing
N8N_WEBHOOK_URL=

# CV uploads (default: ./uploads/cvs)
# CV_UPLOAD_DIR=
# MAX_CV_BYTES=5242880

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# RapidAPI job ingestion
RAPIDAPI_KEY=
RAPIDAPI_MAX_REQUESTS_PER_RUN=80
INGEST_MAX_JOBS_PER_SOURCE=400
